# Copy to .env and fill in. Never commit .env or app.env.

# Name of the stack (prefix of containers and volumes).
STACK_NAME=app

# The domain that points at this server (an A record). Caddy gets the HTTPS
# certificate by itself. "localhost" works for a local try-out.
DOMAIN=example.com

# The port your app listens on inside its container.
APP_PORT=3000

# Image to run. Leave as is to build on the server; CI sets a registry image.
APP_IMAGE=app:local

# Optional parts, comma-separated: db, backup, offsite, monitoring
COMPOSE_PROFILES=db,backup,monitoring

# --- db: Postgres on this server ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=          # generate: openssl rand -hex 24

# --- backup ---
# Empty = dump the "db" service. For an external database (Supabase, Neon …)
# put its connection string here: postgresql://user:password@host:5432/dbname
BACKUP_DATABASE_URL=
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=14

# --- offsite: copy dumps to S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, Hetzner) ---
OFFSITE_PROVIDER=Other      # AWS | Cloudflare | Other
OFFSITE_ENDPOINT=           # empty for AWS; https://<account>.r2.cloudflarestorage.com for R2
OFFSITE_REGION=auto
OFFSITE_BUCKET=
OFFSITE_PREFIX=db
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=

# --- monitoring ---
GRAFANA_ADMIN_PASSWORD=     # generate: openssl rand -hex 16
GRAFANA_PORT=3001
METRICS_RETENTION=15d
